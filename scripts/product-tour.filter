drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='SAFE  CLEAN  COMPLIANT':x=70:y=102:fontsize=16:fontcolor=white@0.6,
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='01':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,0,6)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Food safety':x=70:y=250:fontsize=72:fontcolor=white:enable='between(t,0,6)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='without the paperwork.':x=70:y=340:fontsize=58:fontcolor=white:enable='between(t,0,6)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='One clear system built for UK food businesses.':x=74:y=435:fontsize=25:fontcolor=white@0.78:enable='between(t,0,6)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='02':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,6,12)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Start every shift clearly.':x=70:y=245:fontsize=52:fontcolor=white:enable='between(t,6,12)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Opening. Delivery. Closing. Assigned to the right people.':x=74:y=350:fontsize=23:fontcolor=white@0.78:enable='between(t,6,12)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Due work stays visible until it is completed or corrected.':x=74:y=400:fontsize=21:fontcolor=#4ade80:enable='between(t,6,12)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='03':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,12,18)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Record. Correct. Evidence.':x=70:y=245:fontsize=52:fontcolor=white:enable='between(t,12,18)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Temperatures, cleaning and corrective actions stay connected.':x=74:y=350:fontsize=22:fontcolor=white@0.78:enable='between(t,12,18)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='User and server time are retained in the audit history.':x=74:y=400:fontsize=21:fontcolor=#4ade80:enable='between(t,12,18)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='04':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,18,24)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Keep people evidence current.':x=70:y=245:fontsize=49:fontcolor=white:enable='between(t,18,24)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Training certificates, private documents and expiry dates.':x=74:y=350:fontsize=22:fontcolor=white@0.78:enable='between(t,18,24)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Configured reminders reach the responsible users.':x=74:y=400:fontsize=21:fontcolor=#4ade80:enable='between(t,18,24)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='05':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,24,30)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Scan the asset. See its history.':x=70:y=245:fontsize=48:fontcolor=white:enable='between(t,24,30)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Protected QR labels resolve the right equipment and premises.':x=74:y=350:fontsize=22:fontcolor=white@0.78:enable='between(t,24,30)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Checks, readings, maintenance and corrections in one timeline.':x=74:y=400:fontsize=20:fontcolor=#4ade80:enable='between(t,24,30)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='06':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,30,36)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Act on issues. Share scoped evidence.':x=70:y=245:fontsize=46:fontcolor=white:enable='between(t,30,36)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Alerts route configured deviations to responsible users.':x=74:y=350:fontsize=22:fontcolor=white@0.78:enable='between(t,30,36)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Choose the premises, period and categories for inspection evidence.':x=74:y=400:fontsize=20:fontcolor=#4ade80:enable='between(t,30,36)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='07':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,36,42)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='One system across every screen.':x=70:y=245:fontsize=49:fontcolor=white:enable='between(t,36,42)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Phone. Tablet. Desktop. PWA and native core workflows.':x=74:y=350:fontsize=22:fontcolor=white@0.78:enable='between(t,36,42)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Tenant, premises and role controls protect each view.':x=74:y=400:fontsize=21:fontcolor=#4ade80:enable='between(t,36,42)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='08':x=1030:y=255:fontsize=116:fontcolor=white@0.22:enable='between(t,42,48)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Haccora':x=70:y=230:fontsize=88:fontcolor=white:enable='between(t,42,48)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='SAFE. CLEAN. COMPLIANT.':x=74:y=350:fontsize=29:fontcolor=#4ade80:enable='between(t,42,48)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Built for UK food businesses.':x=74:y=430:fontsize=40:fontcolor=white:enable='between(t,42,48)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='IMPORTANT':x=1010:y=270:fontsize=32:fontcolor=white@0.8:enable='between(t,48,52)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf:text='Your procedures remain yours.':x=70:y=245:fontsize=48:fontcolor=white:enable='between(t,48,52)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Official guidance and business-specific controls remain authoritative.':x=74:y=350:fontsize=21:fontcolor=white@0.75:enable='between(t,48,52)',
drawtext=fontfile=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf:text='Haccora does not guarantee an inspection outcome.':x=74:y=405:fontsize=20:fontcolor=white@0.6:enable='between(t,48,52)',
