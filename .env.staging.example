# Copy to .env.staging for local rehearsals. Never commit the copied file.
# GitHub Actions reads the same values from the protected `staging` Environment.
HACCORA_ENV=staging
STAGING_DEPLOY_CONFIRM=HACCORA_STAGING_ONLY
STAGING_BACKUP_OR_DISPOSABLE_CONFIRMED=false
STAGING_APPLY_CHANGES=false

# The ref must match the hostname exactly. It must never be the production ref.
STAGING_PROJECT_REF=replace-with-staging-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=replace-with-production-project-ref
STAGING_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_staging_key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_ACCESS_TOKEN=replace-with-supabase-personal-access-token
SUPABASE_DB_PASSWORD=replace-with-staging-database-password

# Web release identity. These must be different HTTPS origins.
STAGING_APP_URL=https://staging.haccora.co.uk
PRODUCTION_APP_URL=https://app.haccora.co.uk
EXPECTED_RELEASE_SHA=replace-with-full-40-character-git-sha

# Dedicated demonstration identities; the scripts refuse production mode.
DEMO_ALLOWED_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
DEMO_SEED_CONFIRM=HACCORA_DEMO_ONLY
DEMO_EMAIL_DOMAIN=demo.haccora.co.uk
DEMO_PASSWORD=replace-with-a-unique-16-character-password

# Native internal-candidate workflow settings belong in the GitHub Environment.
EAS_CLI_VERSION=replace-with-an-explicit-three-part-version
EXPO_TOKEN=replace-with-expo-access-token
