{
  "name": "haccora-uk",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/clean-build-output.mjs && vite build && node scripts/check-build-budget.mjs && node scripts/check-built-worker.mjs",
    "build:dev": "vite build --mode development",
    "preview": "nitro preview",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "node scripts/verify-production.mjs",
    "migrations:check": "node scripts/check-migration-lineage.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "health:check": "node scripts/check-deployment-health.mjs",
    "deployment:smoke": "node scripts/check-deployment-smoke.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:sbom": "node scripts/generate-sboms.mjs",
    "release:record-deployment": "node scripts/report-github-deployment.mjs",
    "demo:seed": "node --env-file-if-exists=.env.demo scripts/seed-demo-client.mjs",
    "demo:verify": "node --env-file-if-exists=.env.demo scripts/verify-demo-client.mjs",
    "smoke:worker": "node scripts/check-built-worker.mjs",
    "launch:preflight": "node --env-file-if-exists=.env scripts/verify-launch-env.mjs",
    "quality": "npm run verify && npm run migrations:check && npm run secrets:check && npm run typecheck && npm test && npm run lint:check && npm run format:check && npm run build",
    "demo:access": "node --env-file-if-exists=.env.demo scripts/check-demo-role-access.mjs"
  },
