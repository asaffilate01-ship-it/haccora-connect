# Public web values (safe to expose in the client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Browser push public key generated by your standards-compatible web push provider
VITE_WEB_PUSH_PUBLIC_KEY=

# Server runtime
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
PUBLIC_APP_URL=https://app.haccora.co.uk

# Supabase Edge Function secrets
ALLOWED_ORIGINS=https://app.haccora.co.uk
CONTACT_HASH_SALT=generate-at-least-32-random-characters
CRON_SECRET=generate-at-least-32-random-characters
RESEND_API_KEY=re_server_only_replace_me
NOTIFICATION_FROM_EMAIL=Haccora Alerts <alerts@haccora.co.uk>
# Optional when enhanced Expo push security is enabled
EXPO_ACCESS_TOKEN=
# Required when browser push subscriptions are enabled
WEB_PUSH_GATEWAY_URL=https://push.haccora.co.uk/send
WEB_PUSH_GATEWAY_TOKEN=generate-at-least-32-random-characters
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
# false in staging; true only when the function uses Stripe live-mode credentials
STRIPE_LIVE_MODE=false
# 32+ random characters; rotation requires re-encrypting stored webhook secrets
INTEGRATION_ENCRYPTION_KEY=generate-at-least-32-random-characters
# Enforce a network-level egress proxy/firewall as the second SSRF control for webhook delivery.

# Legal identity — launch is blocked until these are real and counsel-approved
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_ADDRESS_LINE_1=
VITE_LEGAL_POSTAL_CITY=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
VITE_LEGAL_REGISTER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_MANAGING_DIRECTOR=
# Set only after qualified legal review of every public legal page
VITE_LEGAL_CONTENT_APPROVED=false
VITE_SUPPORT_URL=https://support.haccora.co.uk
VITE_STATUS_URL=https://status.haccora.co.uk
