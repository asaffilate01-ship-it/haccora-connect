# Public web values (safe to expose in the client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Browser push public key generated by your standards-compatible web push provider
VITE_WEB_PUSH_PUBLIC_KEY=
# Lovable Payments / Stripe publishable token; pk_test_ in preview, pk_live_ in production
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_replace_me

# Server runtime
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Public marketing origin used for canonical URLs and the sitemap
PUBLIC_MARKETING_URL=https://haccora.co.uk
# Authenticated application origin used for redirects and release probes
PUBLIC_APP_URL=https://app.haccora.co.uk

# Stripe is hosted by Lovable; the server owns the mode and callers cannot override it.
PAYMENTS_RUNTIME_PROVIDER=lovable
PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_WEBHOOK_URL=https://app.haccora.co.uk/api/public/payments/webhook
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
LOVABLE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
# Protected aggregate scheduler/queue health endpoint used by release and uptime checks
OPERATIONS_HEALTH_URL=https://YOUR_PROJECT.supabase.co/functions/v1/operations-health

# Supabase Edge Function secrets
ALLOWED_ORIGINS=https://haccora.co.uk,https://app.haccora.co.uk
CONTACT_HASH_SALT=generate-at-least-32-random-characters
CRON_SECRET=generate-at-least-32-random-characters
# Separate read-only health probe credential; never reuse CRON_SECRET
OPERATIONS_MONITOR_SECRET=generate-a-different-32-character-secret
RESEND_API_KEY=re_server_only_replace_me
NOTIFICATION_FROM_EMAIL=Haccora Alerts <alerts@haccora.co.uk>
# Required by the full production/native release gate; keep only in protected environments
EXPO_ACCESS_TOKEN=
# Public Expo project UUID returned by `eas init`; configure as a protected environment value
EAS_PROJECT_ID=
# Required when browser push subscriptions are enabled
WEB_PUSH_GATEWAY_URL=https://push.haccora.co.uk/send
WEB_PUSH_GATEWAY_TOKEN=generate-at-least-32-random-characters
# Haccora's own scanning endpoint: https://<public-app-domain>/api/public/malware-scan
MALWARE_SCAN_URL=
# Shared bearer secret between the file-scan job and the scanning endpoint (32+ random characters)
MALWARE_SCAN_TOKEN=
# VirusTotal API key used by /api/public/malware-scan; without it uploads fail closed
VIRUSTOTAL_API_KEY=
# 32+ random characters; rotation requires re-encrypting stored webhook secrets
INTEGRATION_ENCRYPTION_KEY=generate-at-least-32-random-characters
# Enforce a network-level egress proxy/firewall as the second SSRF control for webhook delivery.

# Legal identity — launch is blocked until these are real and counsel-approved
VITE_LEGAL_COMPANY_NAME=iTechLounge
VITE_LEGAL_TRADING_NAME=Haccora
VITE_LEGAL_ADDRESS_LINE_1=
VITE_LEGAL_POSTAL_CITY=
VITE_LEGAL_REGISTERED_IN=England and Wales
VITE_LEGAL_COMPANY_NUMBER=
VITE_LEGAL_EMAIL=support@haccora.co.uk
VITE_LEGAL_PHONE=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_ICO_REGISTRATION=
# Set only after qualified legal review of every public legal page
VITE_LEGAL_CONTENT_APPROVED=false
LEGAL_COUNSEL_APPROVAL_REFERENCE=
LEGAL_COUNSEL_APPROVED_AT=
LEGAL_ICO_FEE_STATUS_CONFIRMED=false
VITE_SUPPORT_URL=https://support.haccora.co.uk
VITE_STATUS_URL=https://status.haccora.co.uk
