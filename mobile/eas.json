{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote", "requireCommit": true },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "staging",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
