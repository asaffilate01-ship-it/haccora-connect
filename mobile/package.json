{
  "name": "haccora-uk-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "export:check": "expo export --platform all --output-dir dist --clear",
    "release:preflight": "node scripts/verify-store-readiness.mjs",
